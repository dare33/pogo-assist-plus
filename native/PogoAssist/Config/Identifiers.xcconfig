// The one place the bundle id prefix and the app group live. If Xcode cannot register these
// (an identifier already taken on the developer account), change BUNDLE_ID_PREFIX here and
// nowhere else: the app, the extension, both entitlement files and the Info.plist values all
// derive from it.
BUNDLE_ID_PREFIX = com.dare33
APP_BUNDLE_ID = $(BUNDLE_ID_PREFIX).pogoassist
EXTENSION_BUNDLE_ID = $(BUNDLE_ID_PREFIX).pogoassist.broadcast
APP_GROUP = group.$(BUNDLE_ID_PREFIX).pogoassist

// The signing team is not tracked. Copy Signing.local.xcconfig.example to Signing.local.xcconfig (git-ignored) and put
// your team id there; Xcode then signs without writing the id into the project file. Without it the project builds
// unsigned (simulator) and Xcode asks for a team on the first device run.
#include? "Signing.local.xcconfig"
